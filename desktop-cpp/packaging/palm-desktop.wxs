<?xml version="1.0" encoding="utf-8"?>
<!--
	The MSI of the C++ app, for WiX 3 (package.sh builds it). It installs for the current user into
	%LOCALAPPDATA%\Palm Desktop and keeps the upgrade code of the Swing MSI, so a newer version replaces the
	Swing install in place. The upgrade code must never change.
	Variables: Version (a.b.c), Icon (the .ico file), and the include path of files.wxi, which package.sh
	writes with one File element for the program and each DLL beside it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="Palm Desktop" Language="1033" Version="$(var.Version)" Manufacturer="rearman"
		UpgradeCode="9703d1fd-0a96-45b3-8842-4b8bbcad48dc">
		<Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
			Description="Palm Desktop for Windows" />
		<MajorUpgrade DowngradeErrorMessage="A newer version of Palm Desktop is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<Icon Id="PalmDesktop.ico" SourceFile="$(var.Icon)" />
		<Property Id="ARPPRODUCTICON" Value="PalmDesktop.ico" />
		<Property Id="ARPNOMODIFY" Value="1" />
		<!-- The shortcut boxes start checked; a silent install makes both shortcuts. -->
		<Property Id="DESKTOPSHORTCUT" Value="1" />
		<Property Id="MENUSHORTCUT" Value="1" />

		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="LocalAppDataFolder">
				<Directory Id="INSTALLDIR" Name="Palm Desktop" />
			</Directory>
			<Directory Id="ProgramMenuFolder">
				<Directory Id="PalmMenuFolder" Name="Palm" />
			</Directory>
			<Directory Id="DesktopFolder" />
		</Directory>

		<!-- A per-user component keeps its key path in HKCU, and removes the folders it made in the profile. -->
		<DirectoryRef Id="INSTALLDIR">
			<Component Id="App" Guid="3eabed4d-6fc3-41c0-9028-f9f569785fd6" Win64="yes">
				<?include files.wxi ?>
				<RemoveFolder Id="RemoveInstallDir" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\rearman\Palm Desktop" Name="App" Type="integer" Value="1"
					KeyPath="yes" />
			</Component>
		</DirectoryRef>
		<DirectoryRef Id="PalmMenuFolder">
			<Component Id="MenuShortcut" Guid="453f58a7-d044-4f0d-8ec2-6bf91111f98a" Win64="yes">
				<Condition>MENUSHORTCUT</Condition>
				<Shortcut Id="MenuShortcut" Name="Palm Desktop" Target="[INSTALLDIR]palm-desktop.exe"
					WorkingDirectory="INSTALLDIR" />
				<RemoveFolder Id="RemovePalmMenuFolder" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\rearman\Palm Desktop" Name="MenuShortcut" Type="integer"
					Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>
		<DirectoryRef Id="DesktopFolder">
			<Component Id="DesktopShortcut" Guid="27c4b037-f048-4140-963d-0f22f5c94159" Win64="yes">
				<Condition>DESKTOPSHORTCUT</Condition>
				<Shortcut Id="DesktopShortcut" Name="Palm Desktop" Target="[INSTALLDIR]palm-desktop.exe"
					WorkingDirectory="INSTALLDIR" />
				<RegistryValue Root="HKCU" Key="Software\rearman\Palm Desktop" Name="DesktopShortcut"
					Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>

		<Feature Id="Main" Title="Palm Desktop" Level="1">
			<ComponentRef Id="App" />
			<ComponentRef Id="MenuShortcut" />
			<ComponentRef Id="DesktopShortcut" />
		</Feature>

		<!-- The dialogs of WixUI_Minimal without the license, and a page with the two shortcut boxes. -->
		<UI Id="PalmUI">
			<TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
			<TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
			<TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
			<Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
			<Property Id="WixUI_Mode" Value="Minimal" />

			<DialogRef Id="ErrorDlg" />
			<DialogRef Id="FatalError" />
			<DialogRef Id="FilesInUse" />
			<DialogRef Id="MsiRMFilesInUse" />
			<DialogRef Id="PrepareDlg" />
			<DialogRef Id="ProgressDlg" />
			<DialogRef Id="ResumeDlg" />
			<DialogRef Id="UserExit" />
			<DialogRef Id="WelcomeDlg" />

			<Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
					Text="!(loc.WixUINext)" />
				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
					Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
				</Control>
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
					Text="!(loc.InstallDirDlgBannerBitmap)" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
				<Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
					Text="{\WixUI_Font_Title}Shortcuts" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes"
					NoPrefix="yes" Text="Choose where Setup puts shortcuts to Palm Desktop." />
				<Control Id="DesktopBox" Type="CheckBox" X="20" Y="60" Width="330" Height="17"
					Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="A shortcut on the &amp;desktop" />
				<Control Id="MenuBox" Type="CheckBox" X="20" Y="80" Width="330" Height="17" Property="MENUSHORTCUT"
					CheckBoxValue="1" Text="A shortcut in the &amp;Start menu, under Palm" />
			</Dialog>

			<Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg">NOT Installed</Publish>
			<Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
			<Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="1">
				NOT Installed</Publish>
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">
				Installed</Publish>
			<Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
			<Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">
				1</Publish>
			<Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">
				1</Publish>
			<Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">
				1</Publish>
			<Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">
				1</Publish>
		</UI>
		<UIRef Id="WixUI_Common" />
	</Product>
</Wix>
